{
  "schemaVersion": 1,
  "id": "bettercontroller",
  "version": "${version}",
  "name": "BetterController",
  "description": "Play Minecraft Java with any gamepad. Analog look and movement, full GUI navigation, creative double-tap fly, and a virtual keyboard for chat - in a deliberately small, client-side mod.",
  "authors": [
    "Nekuzaky"
  ],
  "icon": "assets/bettercontroller/icon.png",
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/bettercontroller",
    "sources": "https://github.com/Nekuzaky/BetterController",
    "issues": "https://github.com/Nekuzaky/BetterController/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.bettercontroller.client.BetterControllerClientMod"
    ]
  },
  "mixins": [
    "bettercontroller.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
